# Supabase(또는 다른 Postgres)의 Connection String을 넣어주세요.
# Supabase는 direct(db.xxx.supabase.co:5432)가 IPv6 전용이라 로컬/서버리스에서 막힐 수 있어
# Transaction pooler(포트 6543, 앱 런타임용)를 기본으로 씁니다.
# 예: postgresql://postgres.[project-ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=

# drizzle-kit push/generate 전용. Transaction pooler는 advisory lock 등 세션 단위 기능을
# 지원하지 않아 마이그레이션 명령이 멈출 수 있으므로 Session pooler(포트 5432)를 사용하세요.
# 위 DATABASE_URL과 동일하되 포트만 5432로.
DATABASE_URL_MIGRATIONS=

# 세션 JWT 서명용 비밀키. 아래 명령으로 생성한 랜덤 문자열을 넣어주세요.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# npm run db:seed 실행 시 생성될 최초 관리자 계정 (선택)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=관리자

# 팝빌(popbill.com) 연동 — 세금계산서 실발행 + 카카오 알림톡 발송.
# 아래 값이 비어있으면 세금계산서/배송 알림은 지금처럼 내부 상태만 기록되고, 실제
# 국세청 접수·카카오 발송은 시도하지 않는다(앱이 막히지 않음).
# 1) https://www.popbill.com 회원가입 → 파트너 연동 신청 → LinkID/SecretKey 발급
# 2) 팝빌 콘솔에서 우리 회사 사업자등록번호로 연동회원 가입/인증
POPBILL_LINK_ID=
POPBILL_SECRET_KEY=
POPBILL_CORP_NUM=
# 운영 전환 전까지는 반드시 true(팝빌 테스트 환경) — 실제 국세청 전송은 false일 때만 발생.
POPBILL_IS_TEST=true

# 카카오 알림톡 — 팝빌 콘솔에서 발신프로필(플러스친구) 등록 + 알림톡 템플릿을 카카오
# 심사받아 승인된 뒤에 발급되는 값. 승인 전에는 비워두면 됨(알림톡만 건너뛰고 세금계산서
# 연동은 별개로 동작).
POPBILL_ALIMTALK_SENDER=
POPBILL_ALIMTALK_SHIPPING_TEMPLATE_CODE=
